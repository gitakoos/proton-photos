<?xml version="1.0" encoding="utf-8"?>
<!--
    PlayerView on a SurfaceView surface: the decoder writes straight to a dedicated
    compositor layer (lower power, more reliable playback, no per-frame GL copy), which
    is what a plain gallery player uses and what quirky hardware decoders render correctly.
    Pinch-zoom scales the PlayerView itself through view.scaleX / scaleY / translation (set
    in VideoPlayer's update lambda), NOT a Compose graphicsLayer, which does not transform a
    SurfaceView's separate compositor layer; a SurfaceView's own View transform is synchronised
    from API 24, comfortably above minSdk 26. resize_mode="fit" wraps the surface in an
    AspectRatioFrameLayout that letterboxes the video, preserving its aspect ratio instead of
    stretching to fill. The app's own pill drives playback, so the built-in controller stays off.
-->
<androidx.media3.ui.PlayerView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    app:surface_type="surface_view"
    app:use_controller="false"
    app:resize_mode="fit" />
