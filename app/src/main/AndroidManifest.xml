<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Lets the map view read un-redacted EXIF GPS from on-device photos (Android 10+). -->
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />
    <uses-permission android:name="android.permission.MANAGE_MEDIA" />
    <!-- Optional, opt-in: lets "mirror to local files" wipe metadata / rename the on-device
         original in place where the OS refuses a silent MediaStore write even with MANAGE_MEDIA
         granted. Requested only when the user turns that toggle on. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!--
        FOREGROUND_SERVICE + FOREGROUND_SERVICE_DATA_SYNC are required by AlbumDownloadWorker
        so the album-download Worker can call setForeground() and keep running once the
        user navigates away from the album screen or backgrounds the app. The
        foregroundServiceType="dataSync" attribute on the WorkManager service entry below
        is the Android-12+ counterpart to FOREGROUND_SERVICE_DATA_SYNC.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!--
        Opt-in screenshot quick-actions overlay (ScreenshotOverlayService), enabled from Settings.
        SYSTEM_ALERT_WINDOW backs the floating action bar drawn over other apps; the SPECIAL_USE
        foreground type keeps the MediaStore-observer process alive while the feature is on.
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!--
        POST_NOTIFICATIONS is required on Android 13+ to show the download-progress
        notification. Already requested at runtime alongside media permissions.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
        RECEIVE_BOOT_COMPLETED lets BootCompletedReceiver re-arm the OS content-URI
        trigger and restart BackgroundSyncService after a device reboot, so users who
        reboot and never re-open the app still back up the next camera capture
        automatically.
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!--
        Android 12+ counterpart to REQUEST_INSTALL_PACKAGES: lets the app's own
        PackageInstaller session ask for USER_ACTION_NOT_REQUIRED, so an in-app update
        applies without the system confirmation screen. Only ever used for a self-update.
    -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <application
        android:name=".App"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ProtonPhotos"
        android:localeConfig="@xml/locale_config"
        android:allowNativeHeapPointerTagging="false"
        android:extractNativeLibs="true"
        android:largeHeap="true"
        tools:replace="android:theme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|keyboardHidden|locale|layoutDirection"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
                Surfaces the app in Android's "Open with" / "Edit with" choosers when
                another app shares an image or video via ACTION_EDIT or ACTION_VIEW.
                MIME types cover the common photo and video formats the editor handles.
            -->
            <intent-filter>
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/jpeg" />
                <data android:mimeType="image/png" />
                <data android:mimeType="image/webp" />
                <data android:mimeType="image/heic" />
                <data android:mimeType="image/heif" />
                <data android:mimeType="image/gif" />
                <data android:mimeType="video/mp4" />
                <data android:mimeType="video/quicktime" />
                <data android:mimeType="video/x-matroska" />
                <data android:mimeType="video/webm" />
                <data android:mimeType="video/3gpp" />
            </intent-filter>
            <!--
                ACTION_VIEW for local image/video URIs so the app appears in another app's
                "Open with" chooser. Only the content:// scheme is accepted: a cross-app file://
                URI is refused so a caller cannot aim the app at its own private storage, and the
                parser enforces the same rule. The scheme is stated explicitly because ACTION_VIEW
                with a data type and no scheme trips the AppLinkUrlError lint, which treats a bare
                VIEW filter as an incomplete web link. No BROWSABLE / http(s) here: this is not a
                web link or App Link, only local media handed over by another app.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
            </intent-filter>
            <!--
                Registers the app as a gallery so a camera or system "open gallery"
                action (ACTION_MAIN + CATEGORY_APP_GALLERY) can target it. The launch
                behaves like a normal app start, so no extra handling is needed.
            -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.APP_GALLERY" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Dark theme override for ProtonCore auth screens -->
        <activity
            android:name="me.proton.core.auth.presentation.ui.LoginActivity"
            android:theme="@style/Theme.ProtonPhotos.Auth"
            tools:replace="android:theme" />
        <activity
            android:name="me.proton.core.auth.presentation.ui.LoginTwoStepActivity"
            android:theme="@style/Theme.ProtonPhotos.Auth"
            tools:replace="android:theme" />
        <activity
            android:name="me.proton.core.auth.presentation.ui.SecondFactorActivity"
            android:theme="@style/Theme.ProtonPhotos.Auth"
            tools:replace="android:theme" />
        <activity
            android:name="me.proton.core.auth.presentation.ui.AddAccountActivity"
            android:theme="@style/Theme.ProtonPhotos.Auth"
            tools:replace="android:theme" />
        <activity
            android:name="me.proton.core.auth.presentation.ui.TwoPassModeActivity"
            android:theme="@style/Theme.ProtonPhotos.Auth"
            tools:replace="android:theme" />

        <!--
            Re-arms the SyncWorker MediaStore content-URI trigger after device reboot, so
            users who reboot and never re-open the app still get auto-upload within seconds
            of the next camera capture. Periodic SyncWorker is persisted across reboots by
            WorkManager itself; only the OneTime content-trigger request needs explicit
            re-enqueueing. Receiver lives under .service alongside BackgroundSyncService
            since it also kick-starts that long-running service after boot.
        -->
        <receiver
            android:name=".service.BootCompletedReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!--
            Backs the backup notification's "Stop" action. Requests a cooperative stop of the
            current upload batch (the in-transit photo finishes, queued items are not started)
            instead of WorkManager-cancelling the running worker, which would cancel an in-flight
            native PGP call and crash the process. Not exported: only our own PendingIntent fires it.
        -->
        <receiver
            android:name=".worker.StopUploadReceiver"
            android:exported="false"
            android:enabled="true">
            <intent-filter>
                <action android:name="eu.akoos.photos.action.STOP_UPLOAD" />
            </intent-filter>
        </receiver>

        <!--
            Status callback of the in-app update's PackageInstaller session. Not exported and
            carries no intent-filter: the system reaches it only through the explicit
            PendingIntent the session was committed with.
        -->
        <receiver
            android:name=".data.updater.InstallStatusReceiver"
            android:exported="false"
            android:enabled="true" />

        <!-- ── Photo Widget ──────────────────────────────────────────────── -->
        <receiver
            android:name=".widget.PhotoWidgetReceiver"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/photo_widget_info" />
        </receiver>

        <activity
            android:name=".widget.PhotoWidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.ProtonPhotos">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updater.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_provider_paths" />
        </provider>

        <!--
            Dedicated FileProvider for the share sheet. Neither photo it serves has a MediaStore
            URI: a cloud-only one is decrypted to cacheDir/fullres/, and a vaulted one is the
            app-private file itself, so those two subfolders are exposed here. The provider is not
            exported, so each is only ever reachable through the single read grant a share attaches
            to the one URI it sends. Kept separate from the updater provider above so each authority
            advertises the minimal set of paths it actually needs.
        -->
        <provider
            android:name=".util.ShareFileProvider"
            android:authorities="${applicationId}.share.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/share_paths" />
        </provider>

        <!--
            WorkManager's SystemForegroundService entry — needs explicit
            foregroundServiceType="dataSync" on Android 14+ for any worker that calls
            setForeground(). Without this the system kills the worker on Android 14+ as
            soon as it tries to promote itself.
        -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <!-- Idle ContentObserver foreground service. Holds NO wakelock and does no CPU
             work itself — exists solely to keep the app process alive on Samsung One UI
             so the in-service MediaStore observer can kick SyncWorker the moment a new
             photo appears, even after the user has swiped the app from Recents. LOW
             channel importance so the notification stays out of the way. -->
        <service
            android:name=".service.BackgroundSyncService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Initial face-indexing foreground host. Keeps the process alive so the one-time People
             face-grouping walk runs to completion after the user swipes the app from Recents. LOW
             channel importance; the walk still parks on the shared device-health policy. -->
        <service
            android:name=".service.FaceIndexingService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Opt-in screenshot quick-actions overlay, enabled from Settings. The specialUse foreground
             type needs a declared subtype on Android 14+; the property is harmless on older releases. -->
        <service
            android:name=".service.ScreenshotOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="screenshot_overlay" />
        </service>

        <!-- Drive thumbnail decryption isolated into its own process. The native
             OpenPGP runtime can abort its host process under Android-16 GC when
             ProtonCore's key-unlock crypto races the bulk thumbnail decrypts; running
             those decrypts here keeps a residual SIGABRT off the main UI process. The
             client falls back to in-process decrypt if this service can't bind. -->
        <service
            android:name=".crypto.CryptoService"
            android:process=":crypto"
            android:exported="false" />

    </application>

</manifest>
